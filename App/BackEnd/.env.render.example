# Importa este bloque con "Add from .env" en Render.
# Sustituye todos los valores CHANGE_ME antes de importarlo.

NODE_ENV=production
NODE_VERSION=22

# Render asigna PORT automaticamente; no lo declares aqui.
FRONTEND_URL=https://CHANGE_ME.vercel.app
PUBLIC_API_BASE_URL=https://CHANGE_ME.onrender.com

JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_SECRET
JWT_EXPIRES_IN=3h

DB_HOST=CHANGE_ME_NEON_HOST
DB_PORT=5432
DB_NAME=CHANGE_ME_NEON_DATABASE
DB_USER=CHANGE_ME_NEON_USER
DB_PASSWORD=CHANGE_ME_NEON_PASSWORD
DB_DIALECT=postgres
DB_SSL=true

CLOUDINARY_NAME=CHANGE_ME
CLOUDINARY_KEY=CHANGE_ME
CLOUDINARY_SECRET=CHANGE_ME

API_RATE_LIMIT=500
AUTH_RATE_LIMIT=10
MAX_IMAGE_SIZE_BYTES=5242880

# Render Free bloquea los puertos SMTP 25, 465 y 587.
# Deja SMTP sin configurar hasta integrar un proveedor por API HTTP.
