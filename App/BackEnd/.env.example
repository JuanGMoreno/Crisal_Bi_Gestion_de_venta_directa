PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Para varios orígenes permitidos, separados por coma:
# FRONTEND_URLS=https://app.example.com,https://www.example.com
PUBLIC_API_BASE_URL=http://localhost:4001

API_RATE_LIMIT=500
AUTH_RATE_LIMIT=10
MAX_IMAGE_SIZE_BYTES=5242880

JWT_SECRET=change_me
JWT_EXPIRES_IN=3h

DB_HOST=localhost
DB_PORT=5432
DB_NAME=crisal_database
DB_USER=postgres
DB_PASSWORD=change_me
DB_DIALECT=postgres

CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="CrisalBi Alertas <alerts@example.com>"
SMTP_SECURE=false
